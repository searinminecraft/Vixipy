{% extends "follow/base.html.j2" %}
{% from "components/novel-entry.html.j2" import nentry %}
{% set title = _("Works by users you're following") %}
{% set follow_current = 'illust' %}

{% block follow_content %}
<div class="nav-controller">
    <div class="chip-toggle">
        <a href="{{url_for('follow.bookmark_new_illust')}}">{{_("Illustrations and Manga")}}</a>
        <a class="active">{{_("Novels")}}</a>
    </div>
    <div class="chip-toggle">
        <a {% if request.args.get('mode', 'all') == 'all' %}class="active"{% else %}href="{{url_for('follow.novel_bookmark_new', mode='all')}}"{% endif %}>{{_("All")}}</a>
        <a {% if request.args.get('mode', 'all') == 'r18' %}class="active"{% else %}href="{{url_for('follow.novel_bookmark_new', mode='r18')}}"{% endif %}>R-18</a>
    </div>
</div>

<div class="novels-container">
    {% for x in data %}
    {{nentry(x)}}
    {% endfor %}
</div>
<div class="paginator">
    <a {% if request.args.get('p', 1)|int > 1 %}href="{{url_for('follow.novel_bookmark_new', p=request.args['p']|int - 1, mode=request.args.get('mode', 'all'))}}"
        {% endif %}>
        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3">
            <path
                d="m432-480 156 156q11 11 11 28t-11 28q-11 11-28 11t-28-11L348-452q-6-6-8.5-13t-2.5-15q0-8 2.5-15t8.5-13l184-184q11-11 28-11t28 11q11 11 11 28t-11 28L432-480Z" />
        </svg>
    </a>
    <span>{{_("Page %(page)d", page=request.args.get('p', 1)|int)}}</span>
    <a {% if not is_last
        %}href="{{url_for('follow.novel_bookmark_new', p=(request.args.get('p', 1)|int)+1, mode=request.args.get('mode', 'all'))}}"
        {% endif %}>
        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3">
            <path
                d="M504-480 348-636q-11-11-11-28t11-28q11-11 28-11t28 11l184 184q6 6 8.5 13t2.5 15q0 8-2.5 15t-8.5 13L404-268q-11 11-28 11t-28-11q-11-11-11-28t11-28l156-156Z" />
        </svg>
    </a>
</div>
{% endblock follow_content %}
